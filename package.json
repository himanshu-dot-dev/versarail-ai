{
  "name": "versarail-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first multi-provider desktop AI coding workstation with per-provider token calculation and diff-first security",
  "author": "Himanshu Sharma <himanshudotdev2003@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/himanshu-dot-dev/versarail-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshu-dot-dev/versarail-ai.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/playwright-ui-tour.e2e.mjs",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "lucide-react": "^1.64.0",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.5"
  }
}
